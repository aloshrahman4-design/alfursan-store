# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Google AI Studio API key (https://aistudio.google.com/apikey) -- sign in
# with any Google/Gmail account, click "Create API key", paste it here.
GEMINI_API_KEY=your_gemini_api_key

# "-latest" always points at Google's current fast multimodal model, so you
# never have to notice a model was renamed/retired and come back to edit this.
# GEMINI_FALLBACK_MODELS (comma-separated) are tried in order if the primary
# model's call fails for any reason -- leave both as-is unless you have a
# specific reason to pin an exact model.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Destination channel for the "publish" button.
# Use @channel_username, or the numeric -100xxxxxxxxxx id if the channel has no username.
# The bot must be an admin of this channel with "Post Messages" permission.
CHANNEL_ID=@your_channel_username

# Comma-separated Telegram user IDs allowed to send photos to this bot.
# Leave empty only for local testing -- never in production.
ALLOWED_USER_IDS=111111111,222222222

# Bold TTF used to draw the new price digits patched into images (any font
# with numeral glyphs works -- Cairo-Bold is just a clean-looking default).
FONT_BOLD_PATH=fonts/Cairo-Bold.ttf

# Local JSON Lines audit trail of every published item (see audit_log.py).
AUDIT_LOG_PATH=audit_log.jsonl
