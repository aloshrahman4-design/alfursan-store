# Copy to ~/trading_bot/.env on the server (systemd EnvironmentFile: plain KEY=VALUE, no quotes needed)
META_API_TOKEN=your_metaapi_token
ACCOUNT_ID=your_metaapi_account_id
TELEGRAM_BOT_TOKEN=123456:your_telegram_bot_token

# --- intelligence layer (optional; features switch off gracefully when missing) ---
ANTHROPIC_API_KEY=sk-ant-...          # console.anthropic.com -> API Keys (prepaid credits)
FINNHUB_API_KEY=...                   # finnhub.io free account
# CLAUDE_MODEL=claude-opus-5
# NEWS_POLL_MINUTES=10
# NEWS_MAX_ANALYSES_DAY=12
# DAILY_TRADE_HOUR_UTC=6              # 09:00 Baghdad
# EXTRA_SYMBOLS=EURUSD,US500          # only symbols your broker offers
# TELEGRAM_CHAT_ID=                   # optional; otherwise learned from /start and persisted
# SYMBOL=GOLD
# TRADE_LOT=0.03

# --- weekend cost saver (MetaApi bills per deployed hour) ---
# WEEKEND_SAVER=1                     # 0 disables it
# WEEKEND_CLOSE_HOUR_UTC=21           # Friday close
# WEEKEND_OPEN_HOUR_UTC=22            # Sunday open
# METAAPI_HOURLY_USD=0.035            # only used to report the savings

# --- on-demand execution (MetaApi only deployed when a trade needs it) ---
# ONDEMAND=1                          # 0 = keep the account up all week
# IDLE_SLEEP_MINUTES=20               # idle time before undeploying
# WAKE_GRACE_MINUTES=30               # stay awake this long after a manual wake
# WAKE_TIMEOUT_SECS=120               # how long a button waits for the account to come up

# --- execution platform ---
# BROKER=metaapi                      # metaapi (paid bridge) or capital (free REST API)
# CAPITAL_API_KEY=...                 # capital.com -> Settings -> API integrations
# CAPITAL_EMAIL=you@example.com
# CAPITAL_PASSWORD=...                # the API password you set when creating the key
# CAPITAL_DEMO=1                      # 1 = demo account, 0 = live
# CAPITAL_TRADE_SIZE=1                # order size in the broker's own units
# STOP_LOSS_DIST=0                    # real broker-side stop, in price units (0 = off)
# TAKE_PROFIT_DIST=0
